[Unit]
Description=SurvOm multi-omics demo Dash app
After=network.target

[Service]
Type=simple
User=<USER>
Group=<USER>
WorkingDirectory=/data/shared/vikash/mult-omics/demo_dash_app
Environment="PATH=/home/<USER>/miniconda3/envs/survom-preprocess/bin:/home/<USER>/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="JAVA_CMD=/usr/bin/java"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/<USER>/miniconda3/envs/survom-preprocess/bin/gunicorn server:server --bind 0.0.0.0:8056 --workers 2 --timeout 300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Install:
#   sudo cp systemd/multomics-demo.service /etc/systemd/system/
#   sudo sed -i "s/<USER>/vikash/g" /etc/systemd/system/multomics-demo.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now multomics-demo
